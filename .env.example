# C0/C1: nenhuma variável ou credencial necessária.
# Integrações serão configuradas após revisão dos próximos marcos.

# Servidor apenas: futuro worker de notificações n8n (não usar NEXT_PUBLIC_).
# O protótipo registra os eventos em memória e não executa entregas externas.
ATENDHUB_WEBHOOK_URL=
ATENDHUB_WEBHOOK_SECRET=

# Future authenticated automation worker; the current UI stores URLs in memory.
ATENDHUB_AUTOMATIONS_WEBHOOK_URL=
ATENDHUB_FOLLOWUP_WEBHOOK_URL=
ATENDHUB_REMINDER_WEBHOOK_URL=
