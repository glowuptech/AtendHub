# Supabase público para clientes browser/server com RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor apenas: futuro worker de notificações n8n (não usar NEXT_PUBLIC_).
ATENDHUB_WEBHOOK_URL=
ATENDHUB_WEBHOOK_SECRET=

# Future authenticated automation worker; the current UI stores URLs in memory.
ATENDHUB_AUTOMATIONS_WEBHOOK_URL=
ATENDHUB_FOLLOWUP_WEBHOOK_URL=
ATENDHUB_REMINDER_WEBHOOK_URL=

# Integrações administrativas somente no servidor; nunca expor no browser.
SUPABASE_SERVICE_ROLE_KEY=
# WhatsApp: destino opcional de fallback. URL por organização fica em Configurações > Webhooks.
ATENDHUB_WHATSAPP_CONNECTION_WEBHOOK_URL=
# Segredos independentes para saída ao n8n e callback do n8n.
ATENDHUB_WHATSAPP_WEBHOOK_SECRET=
ATENDHUB_WHATSAPP_CALLBACK_SECRET=
